# 后端 API 地址（不含末尾斜杠）
# 本地开发默认可留空 / 也可改成本地服务：http://localhost:3000
# 生产默认走 Vercel：https://daily-demo-backend.vercel.app
VITE_API_URL=https://daily-demo-backend.vercel.app

# 本仓库 Vercel 部署的书籍搜索与封面代理地址（不含末尾斜杠）
VITE_BOOK_COVER_API_URL=https://www.littlearisa88.com

# 阿丽莎云端记忆 Functions 地址；默认跟随本仓库的 Vercel 部署
VITE_ALISHA_MEMORY_API_URL=https://www.littlearisa88.com

# 仅供 Vercel Functions 使用，严禁添加 VITE_ 前缀或提交真实密钥
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ALISHA_CONTENT_API_URL=https://api.littlearisa88.com
ALISHA_ALLOWED_ORIGINS=https://www.littlearisa88.com,https://littlearisa88.com,https://zhoujie2001.github.io,http://localhost:5173
ALISHA_VISITOR_SIGNING_SECRET=
ALISHA_RATE_LIMIT_SALT=
# 仅用于旧访客 UUID 的一次性迁移，超过该时间后请求头不再被信任
ALISHA_LEGACY_ID_CUTOFF=2026-09-02T00:00:00+08:00
# Vercel Cron 会以 Bearer Token 调用每日清理接口
CRON_SECRET=

# 可选：提高 Google Books 查询配额；不配置时仍可使用公开搜索
GOOGLE_BOOKS_API_KEY=

# 飞书卡片回调，仅供 Vercel Functions 使用
LARK_VERIFICATION_TOKEN=
LARK_APP_ID=
LARK_ENCRYPT_KEY=
