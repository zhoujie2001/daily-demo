{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/book-search.js": {
      "maxDuration": 10
    },
    "api/book-cover.js": {
      "maxDuration": 10
    },
    "api/alisha/memory/*.js": {
      "maxDuration": 10
    },
    "api/lark/callback.js": {
      "maxDuration": 30
    },
    "api/cron/bess-dispatch-cleanup.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/alisha/memory/cleanup",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/bess-dispatch-cleanup",
      "schedule": "10 16 * * *"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/alisha.config.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
