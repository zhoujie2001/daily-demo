{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "fluid": true,
  "regions": ["hnd1"],
  "env": {
    "SUPABASE_REGION": "ap-northeast-1"
  },
  "functions": {
    "api/book-search.js": {
      "maxDuration": 10
    },
    "api/book-cover.js": {
      "maxDuration": 10
    },
    "api/alisha/memory/*.js": {
      "maxDuration": 10
    },
    "api/lark/callback.js": {
      "maxDuration": 300
    },
    "api/dispatch/[action].js": {
      "maxDuration": 30
    },
    "api/cron/bess-dispatch-cleanup.js": {
      "maxDuration": 60
    },
    "api/cron/bess-dispatch-outbox.js": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "bess-dispatch-v2",
          "retryAfterSeconds": 5,
          "initialDelaySeconds": 0
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/alisha/memory/cleanup",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/bess-dispatch-cleanup",
      "schedule": "10 16 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/dispatch/status/batch",
      "destination": "/api/dispatch/status-batch"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/alisha.config.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
